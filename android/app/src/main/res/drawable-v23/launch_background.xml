<?xml version="1.0" encoding="utf-8"?>
<!-- Same gradient as the Flutter splash, with the logo in the middle at
     the size the Flutter splash starts from -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#F8F7F4"
                android:endColor="#F6F1DC"
                android:startColor="#E2EEF0"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_logo"
        android:gravity="center" />
</layer-list>
